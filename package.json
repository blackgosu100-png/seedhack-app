{
  "name": "coupang-signal-app",
  "productName": "씨드핵",
  "version": "0.6.5",
  "description": "SeedHack — Wing·쿠팡 실데이터 기반 소싱 데스크톱 프로그램",
  "type": "module",
  "main": "src/boot.js",
  "seedhackShell": 1,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release:win": "sh scripts/release-win.sh",
    "predist:win": "node scripts/hot-base.mjs",
    "hot": "node scripts/hot-publish.mjs",
    "release:mac": "sh scripts/release-mac.sh"
  },
  "author": "블랙고수",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "onnxruntime-node": "^1.30.0",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "kr.blackgosu.coupangsignal",
    "productName": "쿠팡 소싱 신호등",
    "artifactName": "SeedHack-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!test/**",
      "!dist/**",
      "tools/ocr-mac/**"
    ],
    "directories": {
      "output": "dist/builder"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "src/**/*",
        "package.json",
        "!test/**",
        "!dist/**",
        "tools/ocr-mac/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "SeedHack",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blackgosu100-png",
        "repo": "coupang-signal-releases",
        "releaseType": "release"
      }
    ],
    "executableName": "CoupangSignal",
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "tools/ocr-mac/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ]
  }
}
